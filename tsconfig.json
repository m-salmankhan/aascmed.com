{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "types": [
      "astro/client",
      "@emotion/react",
      "node"
    ],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config*.ts"
  ],
  "exclude": [
    "dist",
    "dist-ssr",
    "node_modules"
  ]
}

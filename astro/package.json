  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@types/node": "25.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"

{
  "name": "aascmed-astro-targets",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build:static": "astro build --config astro.config.static.mjs",
    "build:ssr": "astro build --config astro.config.ssr.mjs",
    "start:ssr": "node dist-ssr/server/entry.mjs",
    "typecheck": "astro check --config astro.config.static.mjs",
    "verify:proof": "node scripts/verify-proof.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:document": "node scripts/verify-document.mjs",
    "verify:public-images": "node scripts/verify-public-images.mjs",
    "verify:public-images-build": "node scripts/verify-public-images-build.mjs",
    "verify:public-images-static-build": "node scripts/verify-public-images-static-build.mjs"
  },
  "dependencies": {
    "@astrojs/node": "10.1.4",
    "@astrojs/react": "7.1.0",
    "astro": "6.4.2"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@emotion/react": "^11.11.0",
    "@napi-rs/canvas": "^0.1.95",
    "sharp": "^0.34.5 || ^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@types/node": "25.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}

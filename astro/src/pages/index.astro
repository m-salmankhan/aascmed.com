---
// Composes the architecture proof with the shared Astro document and React islands.
import ProofPage from "../views/ProofPage";
import { getDraftPreview } from "../server/draft-preview";
import DraftStatus from "../components/DraftStatus";
import VisitCounter from "../components/VisitCounter";
import SiteDocument from "../layouts/SiteDocument.astro";

const target = import.meta.env.PUBLIC_ASTRO_TARGET;
const draft = await getDraftPreview();
if (target === "compiled Node SSR")
  Astro.response.headers.set("Cache-Control", "private, no-store");
const media = {
  src: "/assets/hero-bg.png",
  alt: "Soft green and blue healthcare themed background",
  width: 1920,
  height: 1080,
};
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Astro architecture proof",
};
---

<SiteDocument
  title="Astro architecture proof"
  description="Representative Astro and React rendering proof."
  pathname="/"
  structuredData={structuredData}
>
  <ProofPage target={target} draft={draft} media={media} />
  <VisitCounter client:load />
  <DraftStatus client:load initialTitle={draft.title} />
</SiteDocument>

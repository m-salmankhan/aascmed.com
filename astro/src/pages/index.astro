---
import SiteDocument from '../layouts/SiteDocument.astro';
import { AstroHomePage } from '../../../src/views/astro-home-page';
import { getAstroHomePageData } from '../server/content/home-page.ts';
import { getRouteContentMode, isAstroPreview } from '../server/content/route-data.ts';

const { homePage, siteData, viewProps } = await getAstroHomePageData(getRouteContentMode());
if (isAstroPreview()) Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<SiteDocument
  title="Allergy, Asthma and Sinus Centers in Illinois"
  description={homePage?.metaDescription || ''}
  pathname="/"
  siteSettings={siteData.siteSettings}
  trackingSettings={siteData.trackingSettings}
  useTracking
  appendBusinessNameToTitle={false}
  ogType="website"
>
  <AstroHomePage client:load viewProps={viewProps} siteData={siteData} />
</SiteDocument>

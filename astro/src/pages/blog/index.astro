---
import SiteDocument from '../../layouts/SiteDocument.astro';
import { getBlogArchive, getBlogs, getPublishedBuildSnapshot } from '../../server/content/loaders';
import { getAstroSiteData } from '../../server/content/route-data';
import { toBlogArchiveItems } from '../../server/content/archive-items';
import { AstroBlogArchivePage } from '../../../../src/views/astro-content-pages';

const mode = import.meta.env.PUBLIC_ASTRO_TARGET === 'static' ? 'published' : 'draft';
const recordsPromise = mode === 'published'
  ? getPublishedBuildSnapshot().then((snapshot) => snapshot.blogs)
  : getBlogs(mode);
const [archive, records, siteData] = await Promise.all([
  getBlogArchive(mode), recordsPromise, getAstroSiteData(mode),
]);
const imageModule = mode === 'published' ? await import('../../server/content/public-images') : null;
const imageManifest = imageModule ? await imageModule.getPublishedImageManifest() : null;
const blogs = toBlogArchiveItems(records, imageManifest?.mediaByRoute);
const heading = archive?.heading || 'Blog';
const description = archive?.metaDescription || '';
---

<SiteDocument title={heading} description={description} pathname="/blog/" trackingSettings={siteData.trackingSettings} useTracking={true}>
  <AstroBlogArchivePage client:load pathname="/blog/" siteData={siteData} heading={heading} blocks={archive?.text} blogs={blogs} />
</SiteDocument>

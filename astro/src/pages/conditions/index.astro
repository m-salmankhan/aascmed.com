---
import SiteDocument from '../../layouts/SiteDocument.astro';
import { getConditions, getConditionsArchive, getPublishedBuildSnapshot } from '../../server/content/loaders';
import { getAstroSiteData } from '../../server/content/route-data';
import { toConditionArchiveItems } from '../../server/content/archive-items';
import { AstroConditionsArchivePage } from '../../../../src/views/astro-content-pages';

const mode = import.meta.env.PUBLIC_ASTRO_TARGET === 'static' ? 'published' : 'draft';
const recordsPromise = mode === 'published'
  ? getPublishedBuildSnapshot().then((snapshot) => snapshot.conditions)
  : getConditions(mode);
const [archive, records, siteData] = await Promise.all([
  getConditionsArchive(mode), recordsPromise, getAstroSiteData(mode),
]);
const imageModule = mode === 'published' ? await import('../../server/content/public-images') : null;
const imageManifest = imageModule ? await imageModule.getPublishedImageManifest() : null;
const conditions = toConditionArchiveItems(records, imageManifest?.mediaByRoute);
const heading = archive?.heading || 'Conditions';
const description = archive?.metaDescription || '';
---

<SiteDocument title={heading} description={description} pathname="/conditions/" trackingSettings={siteData.trackingSettings}>
  <AstroConditionsArchivePage client:load pathname="/conditions/" siteData={siteData} heading={heading} blocks={archive?.text} conditions={conditions} />
</SiteDocument>

---
import SiteDocument from '../../layouts/SiteDocument.astro';
import { getProviderBySlug, getProviders } from '../../server/content/loaders';
import { providerPath } from '../../../../src/shared/content/urls';
import { getPageSiteData } from '../../server/content/site-data';
import { AstroProviderPage, AstroContentNotFound } from '../../../../src/views/astro-content-pages';

const isStatic = import.meta.env.PUBLIC_ASTRO_TARGET === 'static';
export const prerender = import.meta.env.PUBLIC_ASTRO_TARGET === 'static';

export async function getStaticPaths() {
  const providers = await getProviders('published');
  return providers.flatMap((provider) => providerPath(provider.slug) ? [{ params: { slug: provider.slug! } }] : []);
}

const mode = isStatic ? 'published' : 'draft';
const provider = await getProviderBySlug(Astro.params.slug || '', mode);
if (!provider) Astro.response.status = 404;
const siteData = provider ? await getPageSiteData(mode) : undefined;
const name = provider?.name?.fullName || 'Untitled';
const honorific = provider?.name?.honorific && provider.name.honorific !== 'None' ? provider.name.honorific : '';
const title = `${honorific} ${name}`.trim();
const description = provider?.description || '';
const pathname = Astro.url.pathname;
---

{provider && siteData ? <SiteDocument title={title} description={description} pathname={pathname} socialImagePath={provider.image?.src} ogType="profile" trackingSettings={siteData.trackingSettings} useTracking={true}>
  <AstroProviderPage client:load pathname={pathname} siteData={siteData} provider={provider} />
</SiteDocument> : <SiteDocument title="Page not found" description="The requested page could not be found." pathname={pathname} noIndex>
  <AstroContentNotFound client:load />
</SiteDocument>}

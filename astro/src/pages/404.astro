---
import SiteDocument from '../layouts/SiteDocument.astro';
import { AstroNotFoundPage } from '../../../src/views/astro-fixed-pages';
import { getAstroSiteData, getRouteContentMode, isAstroPreview } from '../server/content/route-data.ts';

const mode = getRouteContentMode();
const siteData = await getAstroSiteData(mode);
Astro.response.status = 404;
if (isAstroPreview()) Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<SiteDocument
  title="Page Not Found!"
  description="The URL you have entered may be incorrect, or this page has been removed."
  pathname="/404.html"
  siteSettings={siteData.siteSettings}
  trackingSettings={siteData.trackingSettings}
  noIndex
>
  <AstroNotFoundPage client:load siteData={siteData} pathname="/404.html" />
</SiteDocument>

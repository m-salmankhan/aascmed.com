---
import SiteDocument from '../../layouts/SiteDocument.astro';
import { getClinics, getClinicsArchive } from '../../server/content/loaders.ts';
import { getAstroSiteData, getRouteContentMode } from '../../server/content/route-data.ts';
import { toClinicArchiveItems } from '../../server/content/clinic-update-items.ts';
import { AstroClinicsArchivePage } from '../../../../src/views/astro-clinic-update-pages.tsx';

const mode = getRouteContentMode();
const [archive, clinics, siteData] = await Promise.all([
  getClinicsArchive(mode), getClinics(mode), getAstroSiteData(mode),
]);
const heading = archive?.heading || 'Clinics';
const description = archive?.metaDescription || '';
---

<SiteDocument title={heading} description={description} pathname="/clinics/" siteSettings={siteData.siteSettings} trackingSettings={siteData.trackingSettings} useTracking>
  <AstroClinicsArchivePage client:load pathname="/clinics/" siteData={siteData} heading={heading} blocks={archive?.text} practices={toClinicArchiveItems(clinics)} />
</SiteDocument>

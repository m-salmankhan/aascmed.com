---
import SiteDocument from '../../../../layouts/SiteDocument.astro';
import { getServiceUpdateBySlug, getPublishedBuildSnapshot } from '../../../../server/content/loaders.ts';
import { getAstroSiteData, getRouteContentMode, isAstroPreview } from '../../../../server/content/route-data.ts';
import { matchesServiceUpdateRoute } from '../../../../server/content/route-matching.ts';
import { getServiceUpdateRouteParams } from '../../../../server/content/clinic-update-items.ts';
import { AstroServiceUpdatePage } from '../../../../../../src/views/astro-clinic-update-pages.tsx';
import { AstroContentNotFound } from '../../../../../../src/views/astro-content-pages.tsx';
import type { ServiceUpdateRecord } from '../../../../../../src/shared/content/models.ts';

export const prerender = import.meta.env.PUBLIC_ASTRO_TARGET === 'static';

export async function getStaticPaths() {
  const { serviceUpdates } = await getPublishedBuildSnapshot();
  return serviceUpdates.flatMap((update) => {
    const params = getServiceUpdateRouteParams(update);
    return params ? [{ params, props: { staticRecord: update } }] : [];
  });
}

const mode = getRouteContentMode();
const year = Astro.params.year || '';
const month = Astro.params.month || '';
const slug = Astro.params.slug || '';
const validDatePath = /^\d{4}$/.test(year) && /^(0[1-9]|1[0-2])$/.test(month) && Boolean(slug);
let serviceUpdate: ServiceUpdateRecord | null | undefined = mode === 'published'
  ? Astro.props.staticRecord as ServiceUpdateRecord | undefined
  : validDatePath ? await getServiceUpdateBySlug(slug, mode) : null;
const pathname = Astro.url.pathname;
if (!matchesServiceUpdateRoute(pathname, year, month, slug, serviceUpdate)) serviceUpdate = null;
if (!serviceUpdate) Astro.response.status = 404;
const siteData = serviceUpdate ? await getAstroSiteData(mode) : undefined;
if (isAstroPreview()) Astro.response.headers.set('Cache-Control', 'private, no-store');
const title = serviceUpdate?.title || 'Untitled';
const description = serviceUpdate?.description || '';
---

{serviceUpdate && siteData ? <SiteDocument title={title} description={description} pathname={pathname} siteSettings={siteData.siteSettings} trackingSettings={siteData.trackingSettings} ogType="article" useTracking>
  <Fragment slot="head"><meta property="article:section" content="service-updates" /></Fragment>
  <AstroServiceUpdatePage client:load pathname={pathname} siteData={siteData} serviceUpdate={serviceUpdate} />
</SiteDocument> : <SiteDocument title="Page not found" description="The requested page could not be found." pathname={pathname} noIndex>
  <AstroContentNotFound client:load />
</SiteDocument>}

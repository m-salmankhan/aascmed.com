# Private HTTP proxy. Only the Access-enforcing tunnel may reach this network.
:8080 {
    header {
        defer
        Cache-Control "private, no-store"
        X-Robots-Tag "noindex, nofollow"
        Content-Security-Policy "frame-ancestors 'self' {$PREVIEW_FRAME_ORIGINS}"
        -X-Frame-Options
    }
    reverse_proxy aascmed-preview:4321 {
        # Authentication is checked by cloudflared. Do not forward its credentials.
        header_up -Cookie
        header_up -Authorization
        header_up -Cf-Access-Jwt-Assertion
        header_up X-Forwarded-Proto https
        header_down -X-Frame-Options
        header_down -Content-Security-Policy
    }
    encode zstd gzip
    # No access log: avoid recording draft URLs or query strings.
}

# Host runtime configuration; do not commit credentials or this file.
PREVIEW_IMAGE=ghcr.io/OWNER/REPO-preview@sha256:REPLACE_WITH_REVIEWED_DIGEST
GATSBY_STRAPI_API_URL=https://cms.example.com
STRAPI_TOKEN=
# Exact HTTPS origins, space-separated; quote when sourcing .env in a shell.
PREVIEW_FRAME_ORIGINS='https://cms.example.com'
# Absolute host paths. The preflight script creates the config, not the credential.
TUNNEL_CONFIG_FILE=/home/preview-deploy/tunnel-config.json
TUNNEL_CREDENTIALS_FILE=/home/preview-deploy/tunnel-credentials.json
# Input to the preflight renderer; all must be real provisioned values.
PREVIEW_DOMAIN=preview.example.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TEAM_NAME=
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_TUNNEL_ID=

FROM docker.io/library/node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS build
WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --non-interactive
COPY . .
ARG STRAPI_API_URL
ARG STRAPI_MEDIA_ORIGINS
ARG PUBLIC_RUNTIME_API_BASE_URL
ARG PUBLIC_MAPBOX_API_KEY
RUN yarn build:ssr

FROM docker.io/library/node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS dependencies
WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production --non-interactive

FROM docker.io/library/node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4321 ASTRO_CONTENT_MODE=draft
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=build /app/dist-ssr ./dist-ssr
COPY scripts/start-preview.mjs ./scripts/start-preview.mjs
COPY src/server/content/token.mjs ./src/server/content/token.mjs
USER 10002:10002
EXPOSE 4321
CMD ["node", "scripts/start-preview.mjs"]

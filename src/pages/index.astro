---
// Renders the real CMS homepage through the shared homepage view and native Astro document.
import { HomePage } from '../components/pages/HomePage';
import { prepareInlineImages } from '../server/content/inline-images';
import SitePage from '../layouts/SitePage.astro';
import { getPageContext, pageContentMode } from '../server/pages/common';
import { getHomePageData } from '../server/pages/home';
const mode = pageContentMode();
const [{ props, description }, context] = await Promise.all([
  getHomePageData(mode),
  getPageContext(Astro.url.pathname, mode),
]);
await prepareInlineImages(props, mode, 600);
---

<SitePage
  {...context.document}
  title="Allergy, Asthma and Sinus Centers in Illinois"
  description={description}
  appendBusinessNameToTitle={false}
  useTracking
  ogType="website"
>
  <HomePage
    client:load
    {...context.view}
    {...props}
  />
</SitePage>

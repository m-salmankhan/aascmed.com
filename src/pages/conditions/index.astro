---
// Renders the conditions archive with ordered CMS condition summaries.
import { ConditionsArchivePage } from '../../components/pages/ConditionsArchivePage';
import { prepareInlineImages } from '../../server/content/inline-images';
import SitePage from '../../layouts/SitePage.astro';
import { getConditionsArchive, getConditions } from '../../server/content/loaders';
import { getPageContext, pageContentMode } from '../../server/pages/common';
import { conditionPath } from '../../content/urls';
import { getResponsiveMediaDescriptor } from '../../server/content/astro-media';
import type { ConditionViewItem } from '../../views/fixed-archive';
const mode = pageContentMode();
const [record, context] = await Promise.all([getConditionsArchive(mode), getPageContext(Astro.url.pathname, mode)]);
const page = structuredClone(record);
const conditions: ConditionViewItem[] = [];
for await (const condition of getConditions(mode)) {
  const thumbnail = condition.thumbnail
    ? await getResponsiveMediaDescriptor(condition.thumbnail, { width: 800 })
    : condition.thumbnail;
  conditions.push({
    slug: conditionPath(condition.slug) || '/conditions/',
    title: condition.heading || condition.title || 'untitled',
    thumbnail,
  });
}
await prepareInlineImages(page, mode, 1200);
---

<SitePage
  {...context.document}
  title={page?.heading || ''}
  description={page?.metaDescription || ''}
  ogType="website"
>
  <ConditionsArchivePage
    client:load
    {...context.view}
    heading={page?.heading || 'Conditions'}
    blocks={page?.text}
    {conditions}
  />
</SitePage>

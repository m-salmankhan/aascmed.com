---
// Renders the CMS privacy policy using the shared privacy view.
import { PrivacyPage } from '../components/pages/PrivacyPage';
import { prepareInlineImages } from '../server/content/inline-images';
import SitePage from '../layouts/SitePage.astro';
import { getPrivacyPolicy } from '../server/content/loaders';
import { getPageContext, pageContentMode } from '../server/pages/common';
const mode = pageContentMode();
const [record, context] = await Promise.all([getPrivacyPolicy(mode), getPageContext(Astro.url.pathname, mode)]);
const page = structuredClone(record);
const lastUpdated =
  page?.updatedAt && Number.isFinite(Date.parse(page.updatedAt))
    ? new Date(page.updatedAt).toISOString().split('T')[0].replace(/-/g, '.')
    : undefined;
await prepareInlineImages(page, mode, 1200);
---

<SitePage
  {...context.document}
  title={page?.title || ''}
  description={page?.description || ''}
  ogType="article"
  useTracking
>
  <PrivacyPage
    client:load
    {...context.view}
    heading={page?.title || 'Privacy Policy'}
    blocks={page?.text}
    {lastUpdated}
  />
</SitePage>

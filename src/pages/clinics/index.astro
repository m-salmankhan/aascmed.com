---
// Renders clinic cards from the selected published or preview collection.
import { ClinicsArchivePage } from '../../components/pages/ClinicsArchivePage';
import { prepareInlineImages } from '../../server/content/inline-images';
import SitePage from '../../layouts/SitePage.astro';
import { getClinics, getClinicsArchive } from '../../server/content/loaders';
import { pageContentMode, getPageContext } from '../../server/pages/common';
import { clinicSummary } from '../../server/pages/locations';
import type { PracticeSummary } from '../../components/practices/practice-archive';
const mode = pageContentMode();
const [record, context] = await Promise.all([getClinicsArchive(mode), getPageContext(Astro.url.pathname, mode)]);
const page = structuredClone(record);
const practices: PracticeSummary[] = [];
for await (const clinic of getClinics(mode)) {
  practices.push(clinicSummary(clinic));
}
await prepareInlineImages(page, mode, 1200);
---

<SitePage
  {...context.document}
  title={page?.heading || ''}
  description={page?.metaDescription || ''}
  useTracking
>
  <ClinicsArchivePage
    client:load
    {...context.view}
    heading={page?.heading || 'Clinics'}
    blocks={page?.text}
    {practices}
  />
</SitePage>

---
// Resolves dated service updates and rejects URL dates that do not match the CMS record.
import { formatServiceUpdateDate } from '../../../../utils/dates';
import { ServiceUpdatePage } from '../../../../components/pages/ServiceUpdatePage';
import { prepareInlineImages } from '../../../../server/content/inline-images';
import SitePage from '../../../../layouts/SitePage.astro';
import { getServiceUpdateBySlug } from '../../../../server/content/loaders';
import {
  pageContentMode,
  getPageContext,
  isStaticTarget,
} from '../../../../server/pages/common';
import { serviceUpdatePaths } from '../../../../server/pages/locations';
import { serviceUpdatePath } from '../../../../content/urls';

/** Enumerate published calendar segments and slugs for static output.
 * @returns Full records and their route parameters.
 */
export async function getStaticPaths() {
  return serviceUpdatePaths();
}
const record = isStaticTarget()
  ? Astro.props.record
  : await getServiceUpdateBySlug(Astro.params.slug || '', pageContentMode());
const update = structuredClone(record);
const requestedPath = `/service-updates/${Astro.params.year}/${Astro.params.month}/${Astro.params.slug}/`;
if (!update || serviceUpdatePath(update) !== requestedPath) {
  return Astro.rewrite('/404');
}
const context = await getPageContext(Astro.url.pathname, pageContentMode());
await prepareInlineImages(update, pageContentMode(), 1200);
---

<SitePage
  {...context.document}
  title={update.title || 'Untitled'}
  description={update.description || ''}
  ogType="article"
  articleSection="service-updates"
>
  <ServiceUpdatePage
    client:load
    {...context.view}
    serviceUpdate={update}
    dateLabel={formatServiceUpdateDate(update.date)}
  />
</SitePage>

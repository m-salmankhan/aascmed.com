---
// Renders the contact page and its published or preview clinic choices.
import { ContactPage } from '../components/pages/ContactPage';
import { prepareInlineImages } from '../server/content/inline-images';
import SitePage from '../layouts/SitePage.astro';
import { getClinics, getContact } from '../server/content/loaders';
import { getPageContext, pageContentMode } from '../server/pages/common';
import { clinicSummary } from '../server/pages/locations';
import type { PracticeSummary } from '../components/practices/practice-archive';
const mode = pageContentMode();
const [record, context] = await Promise.all([getContact(mode), getPageContext(Astro.url.pathname, mode)]);
const page = structuredClone(record);
const practices: PracticeSummary[] = [];
const clinicOptions: string[] = [];
for await (const clinic of getClinics(mode)) {
  if (clinic.clinicName) clinicOptions.push(clinic.clinicName);
  practices.push(clinicSummary(clinic));
}
await prepareInlineImages(page, mode, 1200);
---

<SitePage
  {...context.document}
  title={page?.heading || ''}
  description={page?.metaDescription || ''}
  ogType="website"
  useTracking
>
  <ContactPage
    client:load
    {...context.view}
    heading={page?.heading || 'Contact Us'}
    blocks={page?.text}
    {practices}
    {clinicOptions}
  />
</SitePage>

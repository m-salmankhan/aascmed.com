{
  "name": "allergy-asthma-and-sinus-centers",
  "version": "1.0.0",
  "private": true,
  "description": "allergy-asthma-and-sinus-centers",
  "author": "Salman Khan",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "gatsby develop",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "typecheck:images": "tsc -p tsconfig.public-images.json",
    "test:ui": "playwright test",
    "test:unit": "node --test tests/unit/content-contracts.test.mjs tests/unit/navigation.test.js tests/unit/public-config.test.mjs tests/unit/public-config-consumers.test.js tests/unit/strapi-loaders.test.mjs tests/unit/astro-document.test.mjs tests/unit/public-images.test.mjs",
    "test:astro": "node --test --test-concurrency=1 tests/integration/astro-document.test.mjs tests/integration/astro-runtime.test.mjs",
    "strapi:types": "node scripts/generate-strapi-openapi.mjs",
    "strapi:types:check": "node scripts/generate-strapi-openapi.mjs --check",
    "test:infrastructure:node": "node --test tests/infrastructure/contracts.test.js tests/infrastructure/review.test.js tests/infrastructure/targets.test.js",
    "test:infrastructure:browser": "playwright test --config playwright.infrastructure.config.js",
    "test:infrastructure": "yarn test:infrastructure:node && yarn test:infrastructure:browser",
    "test:smoke": "playwright test tests/ui/behavior.spec.js",
    "astro:static": "yarn --cwd astro build:static",
    "astro:ssr:build": "yarn --cwd astro build:ssr",
    "astro:ssr:start": "yarn --cwd astro start:ssr"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.14.1",
    "@napi-rs/canvas": "^0.1.95",
    "@strapi/blocks-react-renderer": "^1.0.2",
    "@strapi/client": "1.6.2",
    "color": "^5",
    "gatsby": "^5.16.0",
    "gatsby-omni-font-loader": "^2.0.2",
    "gatsby-plugin-emotion": "^8.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-source-strapi": "^5.0.4",
    "gatsby-transformer-sharp": "^5.16.0",
    "graphql": "^16.13.0",
    "mapbox-gl": "^3.33.0",
    "pure-react-carousel": "^1.35.0",
    "react": "^18",
    "react-dom": "^18",
    "react-helmet": "^6.1.0",
    "sharp": "^0.35.5"
  },
  "resolutions": {
    "graphql": "^16.12.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/color": "^4",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "formdata-node": "^6.0.3",
    "gatsby-plugin-webpack-bundle-analyser-v2": "^1.1.31",
    "gray-matter": "^4.0.3",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "openapi-typescript": "7.10.1"
  }
}

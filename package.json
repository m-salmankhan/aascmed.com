{
  "name": "allergy-asthma-and-sinus-centers",
  "version": "1.0.0",
  "private": true,
  "description": "Astro website for Allergy, Asthma and Sinus Centers",
  "author": "Salman Khan",
  "keywords": [
    "astro"
  ],
  "scripts": {
    "develop": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "serve": "astro preview",
    "typecheck": "astro check",
    "test:ui": "playwright test",
    "test:unit": "node --test tests/unit/content-contracts.test.mjs tests/unit/navigation.test.js tests/unit/public-config.test.mjs tests/unit/public-config-consumers.test.js tests/unit/strapi-loaders.test.mjs tests/unit/astro-document.test.mjs tests/unit/public-images.test.mjs tests/unit/public-image-build.test.mjs",
    "test:astro": "node --test --test-concurrency=1 tests/integration/astro-config.test.mjs tests/integration/astro-document.test.mjs tests/integration/astro-runtime.test.mjs tests/integration/astro-public-images.test.mjs tests/integration/astro-hydration.test.mjs tests/integration/astro-content-parity.test.mjs",
    "strapi:types": "node scripts/generate-strapi-openapi.mjs",
    "strapi:types:check": "node scripts/generate-strapi-openapi.mjs --check",
    "test:infrastructure:node": "node --test tests/infrastructure/contracts.test.js tests/infrastructure/review.test.js tests/infrastructure/targets.test.js",
    "test:infrastructure:browser": "playwright test --config playwright.infrastructure.config.js",
    "test:infrastructure": "yarn test:infrastructure:node && yarn test:infrastructure:browser",
    "test:smoke": "playwright test tests/ui/behavior.spec.js",
    "dev": "astro dev",
    "preview": "astro preview",
    "build:ssr": "astro build --config astro.config.ssr.ts",
    "start:ssr": "node dist-ssr/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "10.1.4",
    "@astrojs/react": "7.1.0",
    "@astrojs/sitemap": "3.7.4",
    "@emotion/react": "^11.11.1",
    "@emotion/serialize": "1.3.3",
    "@napi-rs/canvas": "^0.1.95",
    "@strapi/blocks-react-renderer": "^1.0.2",
    "@strapi/client": "1.6.2",
    "astro": "6.4.2",
    "color": "^5",
    "mapbox-gl": "^3.33.0",
    "moment": "2.30.1",
    "pure-react-carousel": "^1.35.0",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.5",
    "vite": "7.3.7"
  },
  "resolutions": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "^1.56.1",
    "@types/color": "^4",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "25.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "formdata-node": "^6.0.3",
    "gray-matter": "^4.0.3",
    "openapi-typescript": "7.10.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "yarn@1.22.22"
}

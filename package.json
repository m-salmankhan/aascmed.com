{
  "name": "allergy-asthma-and-sinus-centers",
  "version": "1.0.0",
  "private": true,
  "description": "Astro website for Allergy, Asthma and Sinus Centers",
  "author": "Salman Khan",
  "keywords": [
    "astro"
  ],
  "scripts": {
    "develop": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "serve": "astro preview",
    "typecheck": "astro check",
    "test:ui": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.*\"",
    "test:astro": "node --test --test-concurrency=1 \"tests/integration/*.test.mjs\"",
    "strapi:types": "node scripts/generate-strapi-openapi.mjs",
    "strapi:types:check": "node scripts/generate-strapi-openapi.mjs --check",
    "test:infrastructure:node": "node --test \"tests/infrastructure/*.test.js\"",
    "test:infrastructure:browser": "playwright test --config playwright.infrastructure.config.js",
    "test:infrastructure": "yarn test:infrastructure:node && yarn test:infrastructure:browser",
    "test:smoke": "playwright test tests/ui/behavior.spec.js",
    "dev": "astro dev",
    "preview": "astro preview",
    "build:ssr": "astro build --config astro.config.ssr.ts",
    "start:ssr": "node dist-ssr/server/entry.mjs",
    "lint": "eslint src scripts tests *.ts *.js *.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,mts,astro}\" \"tests/**/*.{js,mjs}\" \"scripts/*.{js,mjs}\" \"*.{ts,js,mjs,json}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mts,astro}\" \"tests/**/*.{js,mjs}\" \"scripts/*.{js,mjs}\" \"*.{ts,js,mjs,json}\" \".github/workflows/*.yml\""
  },
  "dependencies": {
    "@astrojs/node": "10.1.4",
    "@astrojs/react": "7.1.5",
    "@astrojs/sitemap": "3.7.4",
    "@emotion/react": "^11.11.1",
    "@emotion/serialize": "1.3.3",
    "@napi-rs/canvas": "^1.1.1",
    "@strapi/blocks-react-renderer": "^1.0.2",
    "@strapi/client": "1.6.2",
    "astro": "6.4.2",
    "color": "^5",
    "mapbox-gl": "^3.35.0",
    "moment": "2.31.0",
    "pure-react-carousel": "^1.35.0",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.5",
    "vite": "7.3.7"
  },
  "resolutions": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@netlify/cache-utils": "7.1.3",
    "@playwright/test": "^1.65.1",
    "@types/color": "^4",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "26.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10",
    "eslint-plugin-astro": "1",
    "eslint-plugin-jsx-a11y": "6",
    "eslint-plugin-react-hooks": "7",
    "formdata-node": "^6.0.3",
    "gray-matter": "^4.0.3",
    "openapi-typescript": "7.13.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "3",
    "prettier-plugin-astro": "0.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "yarn@1.22.22"
}

# Server-side CMS origin and Content API token for public Astro builds.
# Use read-only published-content permissions for the public deployment.
STRAPI_API_URL=
STRAPI_TOKEN=

# Intentionally browser-visible settings embedded when the site is built.
PUBLIC_RUNTIME_API_BASE_URL=https://api.aascmed.com
PUBLIC_MAPBOX_API_KEY=

# Defaults to published. Use draft only on protected editorial SSR preview.
ASTRO_CONTENT_MODE=published
# Optional comma-separated extra CMS upload/CDN origins (no paths).
STRAPI_MEDIA_ORIGINS=
# Optional comma-separated extra editor origins permitted to embed SSR preview.
PREVIEW_FRAME_ORIGINS=

# Gatsby and its legacy preview have been removed. See docs/environment-variables.md.

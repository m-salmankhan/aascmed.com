# Gatsby configuration. GATSBY_ values may be included in browser assets.
# Keep these alongside the separate Astro values during the migration.
GATSBY_STRAPI_API_URL=
GATSBY_MAPBOX_API_KEY=
# Public non-content API used by the contact form; separate from the CMS.
GATSBY_API_BASE_URL=
# Public Gatsby builds use published content; legacy preview sets this to true.
GATSBY_IS_PREVIEW=false

# Server-only CMS credential shared by Gatsby and Astro; never use a public prefix.
STRAPI_TOKEN=

# Astro server-side CMS origin. Set independently of GATSBY_STRAPI_API_URL.
STRAPI_API_URL=
# Astro browser settings, embedded at build time.
PUBLIC_RUNTIME_API_BASE_URL=
PUBLIC_MAPBOX_API_KEY=

# Astro server-only content mode. Draft is only for protected SSR preview.
ASTRO_CONTENT_MODE=published
# Optional extra origins allowed to embed Astro preview, comma-separated.
# The configured Astro CMS origin and the preview itself are already permitted.
PREVIEW_FRAME_ORIGINS=
# Optional additional upload/CDN origins; full origins, comma-separated.
# Astro includes the STRAPI_API_URL origin automatically.
STRAPI_MEDIA_ORIGINS=

# See docs/environment-variables.md for the complete per-deployment inventory,
# legacy preview settings, optional tools, and where to supply each value.

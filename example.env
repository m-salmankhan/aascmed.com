# Gatsby public build/runtime configuration. These values may be embedded in browser assets.
GATSBY_STRAPI_API_URL=
GATSBY_MAPBOX_API_KEY=
# Existing public contact-form backend URL; this is separate from the Strapi CMS URL above.
GATSBY_API_BASE_URL=

# Gatsby build/server-only CMS credential; never prefix secrets with GATSBY_.
STRAPI_TOKEN=

# Astro public configuration. PUBLIC_ values are included in browser assets.
# Contact-form backend base URL; this is separate from the Strapi CMS URL.
PUBLIC_CONTACT_API_BASE_URL=
PUBLIC_MAPBOX_API_KEY=

# Stage 1 proof only: full Strapi REST resource URL (not a separate draft CMS host).
# The proof adds status=draft; a production loader will use a server-only Strapi base with status=published.
ASTRO_DRAFT_API_URL=
ASTRO_STRAPI_TOKEN=

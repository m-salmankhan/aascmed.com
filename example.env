# Gatsby public build/runtime configuration. These values may be embedded in browser assets.
GATSBY_STRAPI_API_URL=
GATSBY_MAPBOX_API_KEY=
GATSBY_API_BASE_URL=

# Gatsby build/server-only CMS credential; never prefix secrets with GATSBY_.
STRAPI_TOKEN=

# Astro public configuration. PUBLIC_ values are included in browser assets.
PUBLIC_API_BASE_URL=
PUBLIC_MAPBOX_API_KEY=

# Astro preview server-only settings. Keep these out of public build environments/artifacts.
# Collection and single-type REST API origin for the public static content build.
ASTRO_STRAPI_API_URL=
# Separate authenticated API origin for request-time draft loaders (not the proof endpoint below).
ASTRO_DRAFT_STRAPI_API_URL=
ASTRO_DRAFT_API_URL=
ASTRO_STRAPI_TOKEN=
